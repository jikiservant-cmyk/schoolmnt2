# Optional production security & operational controls:
# REGISTER_TOKEN_SECRET=""      # Dedicated HMAC secret for classroom register / gate kiosk capability tokens
# TRUSTED_PROXY_HOPS="1"        # Set to positive hop count behind a trusted reverse proxy (auto=1 on Cloud Run / Vercel)
# MAX_DEVICES_PER_SCHOOL="20"   # Per-school biometric hardware quota
# SIGNUP_INVITE_CODE=""         # Require an invite code during self-service /signup when set


# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NAJIKI_API_KEY=
NAJIKI_DOMAIN=api.najiki.com
NAJIKI_TENANT_CODE=smartskoolz
# Application code registered in the NaJiki gateway (`applications.code`).
NAJIKI_APP_CODE=school
# Payment type NaJiki files this charge under. SMS credits are a PLATFORM FEE,
# so it must be one of najiki-finance2's PLATFORM_FEE_TYPES
# (SMS | BUY_SMS | SMS_TOPUP | ACTIVATION | ACCOUNT_ACTIVATION | SUBSCRIPTION |
#  MONTHLY_SUBSCRIPTION | PLATFORM_FEE). BUY_SMS is the code NaJiki itself seeds
# for "SMS credits top-up (platform fee)". Any other value is treated as a
# tenant collection, which requires per-tenant gateway credentials and fails
# with 503 when the school has none.
NAJIKI_PAYMENT_TYPE_CODE=BUY_SMS

# --- SMS Edge Function (supabase/functions/send-sms) -------------------------
# These belong to the EDGE FUNCTION, not to the Next.js app. The app only queues
# `pending` rows in school.notifications; it never sends an SMS.
# Set them with:  supabase secrets set NAME=value
#
# The names already deployed on the project (kept, so a redeploy needs no secret
# changes). SMS_COST has NO default: an unset price refuses to send (503) rather
# than silently charging 1 UGX.
# DISPATCH_SECRET=""            # required; Bearer token (x-dispatch-secret also accepted)
# NAJIKI_DOMAIN="https://api.najiki.com"   # /api/messaging/send is appended
# NAJIKI_API_KEY=""
# SMS_COST="30"                 # PLATFORM-ONLY price per SMS
# NAJIKI_TIMEOUT_MS="30000"
# Optional aliases/tuning also honoured:
# NAJIKI_APP_CODE="school"      # sent as applicationCode
# NAJIKI_SENDER_ID="SMARTSKOOLZ"
# NAJIKI_API_URL="https://<gateway>/api/messaging/send"   # full URL wins over NAJIKI_DOMAIN
# SMS_UNIT_PRICE_UGX="30"       # alias for SMS_COST
# SMS_BATCH_BUDGET_MS="45000"   # soft stop for the retry sweep
