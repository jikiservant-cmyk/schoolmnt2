# Supabase project settings. Replace placeholders before starting the app.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional independent secret for short-lived manual-attendance sessions (32+ characters).
# If omitted, the server derives the signing key from the service-role key.
# ATTENDANCE_SESSION_SECRET=""

# NaJiki payment API. Configure either NAJIKI_API_URL or NAJIKI_DOMAIN.
NAJIKI_API_KEY=""
NAJIKI_API_URL="https://api.najiki.com/api/payments"
# NAJIKI_DOMAIN="api.najiki.com"
NAJIKI_APP_CODE="school"
